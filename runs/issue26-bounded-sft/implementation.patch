diff --git a/src/bashlet/training.py b/src/bashlet/training.py
index d72bc92..bd01ad8 100644
--- a/src/bashlet/training.py
+++ b/src/bashlet/training.py
@@ -54,0 +55 @@ class SFTConfig:
+    max_epochs: int | None = None
@@ -81,0 +83,4 @@ class SFTConfig:
+        if config.max_epochs is not None and (
+            type(config.max_epochs) is not int or config.max_epochs < 1
+        ):
+            raise ValueError("max_epochs must be a positive integer")
@@ -349,0 +355,18 @@ def training_cost(ledger: SpendLedger, run_id: str) -> dict[str, Any]:
+def _data_progress(
+    datums: list[trio.Datum], updates: list[dict[str, Any]]
+) -> dict[str, int | float]:
+    samples = sum(update["samples"] for update in updates)
+    return {
+        "dataset_samples": len(datums),
+        "dataset_supervised_tokens": int(
+            sum(sum(d.loss_fn_inputs["weights"].tolist()) for d in datums)
+        ),
+        "samples_processed": samples,
+        "epochs_processed": samples / len(datums),
+        "input_tokens_processed": sum(update["input_tokens"] for update in updates),
+        "supervised_tokens_processed": sum(
+            update["supervised_tokens"] for update in updates
+        ),
+    }
+
+
@@ -360,0 +384,5 @@ def _train_sft(
+    batches_per_epoch = math.ceil(len(datums) / config.batch_size)
+    if config.max_epochs is not None and (
+        config.steps > config.max_epochs * batches_per_epoch
+    ):
+        raise ValueError("Planned SFT training exceeds max_epochs")
@@ -382,0 +411,2 @@ def _train_sft(
+    if config.max_epochs is None:
+        settings.pop("max_epochs")
@@ -407,0 +438,2 @@ def _train_sft(
+    if config.max_epochs is not None:
+        metadata["training"]["max_epochs"] = config.max_epochs
@@ -454,0 +487 @@ def _train_sft(
+    record["data_progress"] = _data_progress(datums, record["updates"])
@@ -469 +501,0 @@ def _train_sft(
-        batches_per_epoch = math.ceil(len(datums) / config.batch_size)
@@ -485,0 +518 @@ def _train_sft(
+            record["data_progress"] = _data_progress(datums, record["updates"])
@@ -501,0 +535,3 @@ def _train_sft(
+                metrics.update(
+                    {f"train/{k}": v for k, v in record["data_progress"].items()}
+                )
@@ -504,0 +541 @@ def _train_sft(
+                checkpoint["data_progress"] = dict(record["data_progress"])
diff --git a/tests/test_training.py b/tests/test_training.py
index 29bda58..d49d2b4 100644
--- a/tests/test_training.py
+++ b/tests/test_training.py
@@ -184,0 +185,26 @@ def training_config(tmp_path: Path, manifest: Path) -> Path:
+def test_single_pass_limit_refuses_extra_updates_before_training(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    manifest = training_input(tmp_path)
+    config = training_config(tmp_path, manifest)
+    settings = yaml.safe_load(config.read_text())
+    settings["max_epochs"] = 1
+    config.write_text(yaml.safe_dump(settings))
+    external_sdks(tmp_path, monkeypatch)
+    with (tmp_path / "sitecustomize.py").open("a") as stream:
+        stream.write("import training_sdk\ntraining_sdk.install()\n")
+    monkeypatch.setenv("PYTRIO_API_KEY", "test-key")
+    monkeypatch.setenv("FAKE_TRAINING_ROOT", str(tmp_path))
+    process = cli(
+        "train-sft",
+        str(config),
+        "--output-dir",
+        str(tmp_path / "training"),
+        "--stop-after",
+        "1",
+        cwd=tmp_path,
+    )
+    assert process.returncode == 2 and "exceeds max_epochs" in process.stderr
+    assert not (tmp_path / "training-requests.jsonl").exists()
+
+
@@ -203,0 +230,6 @@ def test_training_waits_for_updates_and_resumes_optimizer_without_relogging_step
+    supervised = json.loads((tmp_path / "examples.jsonl").read_text())["metadata"][
+        "supervised_tokens"
+    ]
+    assert state["data_progress"]["samples_processed"] == 1
+    assert state["data_progress"]["supervised_tokens_processed"] == supervised
+    assert state["data_progress"]["epochs_processed"] == 1.0
@@ -220,0 +253,4 @@ def test_training_waits_for_updates_and_resumes_optimizer_without_relogging_step
+    assert final["data_progress"]["samples_processed"] == 2
+    assert final["data_progress"]["supervised_tokens_processed"] == 2 * supervised
+    assert final["data_progress"]["epochs_processed"] == 2.0
+    assert final["checkpoints"][-1]["data_progress"] == final["data_progress"]
