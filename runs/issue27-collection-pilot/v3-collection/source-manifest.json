      "submission_files": 1024,
      "memory_bytes": 536870912,
      "file_bytes": 1048576,
      "nofile": 64,
      "path": "/opt/bin:/opt/python/bin:/usr/bin:/bin",
      "lang": "C.UTF-8",
      "home": "/home/agent",
      "python": {
