        "variables": {
          "PYTHONDONTWRITEBYTECODE": "1",
          "PYTEST_ADDOPTS": "-p no:cacheprovider",
          "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"
        },
        "etc_files": {
          "passwd": "agent:x:{uid}:{gid}:Sandbox agent:{home}:/bin/bash\n",
          "group": "agent:x:{gid}:\n",
          "hosts": "127.0.0.1 localhost\n::1 localhost\n",
          "nsswitch.conf": "passwd: files\ngroup: files\nhosts: files\n",
          "resolv.conf": "nameserver 127.0.0.1\n",
          "gitconfig": "[user]\n\tname = agent\n\temail = agent@localhost\n[init]\n\tdefaultBranch = main\n"
